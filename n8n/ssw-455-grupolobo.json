      "id": "ebea2987-5bf9-41b2-8b61-2521bee5b1cb",
      "name": "Historico - iniciar (manual)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// ===== CONFIGURACAO =====\nconst MES_INICIAL = '';      // 'AAAA-MM' para retomar de um mes; vazio = mes atual\nconst MAX_MESES = 6;         // meses por execucao (protege a memoria da VPS)\nconst LIMITE_VAZIOS = 3;     // para apos N meses seguidos sem CTRC (= achou o inicio)\nconst MES_MINIMO = '2010-01';\nconst UNIDADE = 'SJP';       // unidade do formulario da 455 (campo f2)\n// =========================\nconst pad = (n) => String(n).padStart(2, '0');\nconst ent = $input.first().json;\nconst hojeBR = new Date(Date.now() - 3 * 3600e3);\nlet ano, mes, vazios = 0, feitos = 0, historico = [];\nif (ent.ano) ({ ano, mes, vazios, feitos, historico } = ent);\nelse if (MES_INICIAL) { [ano, mes] = MES_INICIAL.split('-').map(Number); }\nelse { ano = hojeBR.getUTCFullYear(); mes = hojeBR.getUTCMonth() + 1; }\nconst ultimo = new Date(Date.UTC(ano, mes, 0)).getUTCDate();\nconst atual = ano === hojeBR.getUTCFullYear() && mes === hojeBR.getUTCMonth() + 1;\nconst yy = String(ano).slice(2);\nconst f11 = `01${pad(mes)}${yy}`, f12 = `${pad(atual ? hojeBR.getUTCDate() : ultimo)}${pad(mes)}${yy}`;\nreturn [{ json: { ano, mes, rotulo: `${ano}-${pad(mes)}`, vazios, feitos, historico, f11, f12,\n  campos: JSON.stringify({ f2: UNIDADE, f11, f12 }), MAX_MESES, LIMITE_VAZIOS, MES_MINIMO } }];"
      },
