    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const pad = (n) => String(n).padStart(2, '0');\nconst c = $('Historico - Controle').item.json;\nconst r = $json;\nconst linhas = Number(r.linhas || 0);\nconst erro = r.error || r.erro || null;\nconst vazios = linhas > 0 ? 0 : c.vazios + 1;\nconst historico = [...c.historico, { mes: c.rotulo, periodo: `${c.f11}-${c.f12}`, linhas, novos: r.novos || 0, atualizados: r.atualizados || 0, erro }];\nlet ano = c.ano, mes = c.mes - 1; if (mes === 0) { mes = 12; ano--; }\nconst feitos = c.feitos + 1;\nconst proximo = `${ano}-${pad(mes)}`;\nconst fim_dados = vazios >= c.LIMITE_VAZIOS || proximo < c.MES_MINIMO;\nconst parar = fim_dados || feitos >= c.MAX_MESES;\nreturn { json: { ano, mes, vazios, feitos, historico, parar, fim_dados, proximo_mes: proximo } };"
      },
