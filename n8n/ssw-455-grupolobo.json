    {
      "parameters": {
        "jsCode": "const r = $json;\nconst comDados = r.historico.filter((h) => h.linhas > 0);\nreturn [{ json: {\n  mes_mais_antigo_com_dados: comDados.length ? comDados[comDados.length - 1].mes : null,\n  chegou_no_inicio: r.fim_dados,\n  retomar_em: r.fim_dados ? null : r.proximo_mes,\n  total_linhas: r.historico.reduce((s, h) => s + h.linhas, 0),\n  meses: r.historico,\n} }];"
      },
